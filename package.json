{
  "name": "paranoidclick",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n worker,app -c cyan,green \"npm:dev:worker\" \"npm:dev:app\"",
    "dev:worker": "wrangler dev --local --port 8787 --var PC_LOG_URLS:1",
    "dev:app": "vite",
    "build": "vite build && tsx scripts/build-sw.ts",
    "preview": "npm run build && wrangler dev --assets=dist --local --port 8787 --var PC_LOG_URLS:1",
    "login": "wrangler login",
    "deploy": "npm run build && wrangler deploy",
    "secret": "wrangler secret put PC_ALLOWED_ORIGIN",
    "list": "wrangler vars list",
    "tail": "wrangler tail",
    "smoke": "tsx scripts/smoke-ws.ts",
    "attack": "tsx scripts/attack.ts",
    "lint:arch": "tsx scripts/lint-arch.ts",
    "cek:ikon": "node scripts/gerbang-ikon.mjs",
    "cek:ikon:http": "node scripts/gerbang-ikon.mjs --served http://localhost:8787",
    "cek:sw:http": "node scripts/cek-sw.mjs --served http://localhost:8787",
    "cek:precache:http": "node scripts/cek-precache.mjs --served http://localhost:8787",
    "cek:kontras": "node scripts/cr.mjs",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check": "npm run typecheck && npm run lint:arch && npm run test && npm run test:worker"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.475.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "wreq-js": "^3.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@types/animejs": "^3.1.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
