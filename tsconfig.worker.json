{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "worker-configuration.d.ts",
    "node_modules/@cloudflare/vitest-plugin/types/cloudflare-test.d.ts",
    "src/worker/**/*",
    "src/shared/**/*"
  ]
}
